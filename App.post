app.post("/api/challenges", (req, res) => {
      const { userId, complaint } = req.body;
      
      if (!userId || !complaint) {
      return res.status(400).json({
      error: "User ID and complaint are required"
      });
      }
      
      res.status(201).json({
      message: "Health challenge submitted successfully",
      challenge: {
      userId,
      complaint
      }
      });
      });
